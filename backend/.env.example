# sqlite (local dev, default) or mysql (production)
DB_DRIVER=sqlite
# DB_PATH=/absolute/path/technothics.sqlite

# MySQL / MariaDB
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=technothics
# DB_USER=technothics
# DB_PASS=change-me

# Comma-separated list of allowed front-end origins, e.g. https://technothics.vercel.app
CORS_ORIGINS=*

# When set, POST/PATCH requests must send header X-Api-Key with this value
# API_KEY=

APP_DEBUG=0
